Options -MultiViews
RewriteEngine On

# Force /bio to the main-site page: a bio/ directory exists here as the
# docroot for the consultor.lezacconsultoria.com subdomain, so the generic
# rule below (which skips real directories) would never reach bio.html.
RewriteRule ^bio/?$ bio.html [L]

# /blog es la página del listado; blog/ es la carpeta de artículos
RewriteRule ^blog/?$ blog.html [L]

# URLs anteriores -> URL final (301, un solo salto; acepta con y sin .html)
RewriteRule ^brujula-comercial(\.html)?/?$  /consultoria-inteligencia-comercial [R=301,L]
RewriteRule ^smart-brujula(\.html)?/?$      /consultoria-inteligencia-comercial [R=301,L]
RewriteRule ^ia-aplicada(\.html)?/?$        /ia-a-medida [R=301,L]
RewriteRule ^wa-smart-ventas(\.html)?/?$    /wa-ventas [R=301,L]
RewriteRule ^censo-comercial(\.html)?/?$    /mas-clientes-activos [R=301,L]
RewriteRule ^geolocalizacion(\.html)?/?$    /mas-clientes-activos [R=301,L]
RewriteRule ^ruteo-comercial(\.html)?/?$    /mas-clientes-activos [R=301,L]
RewriteRule ^partners(\.html)?/?$           /partner [R=301,L]

# Páginas del sitio WordPress anterior -> servicio equivalente o home (301)
RewriteRule ^geolocalizacionclientes(\.html)?/?$ /mas-clientes-activos [R=301,L]
RewriteRule ^asesoriaclientes(\.html)?/?$ /mas-clientes-activos [R=301,L]
RewriteRule ^ruteocomercial(\.html)?/?$ /mas-clientes-activos [R=301,L]
RewriteRule ^brujulacomercial(\.html)?/?$ /consultoria-inteligencia-comercial [R=301,L]
RewriteRule ^reportecomercial(\.html)?/?$ /consultoria-inteligencia-comercial [R=301,L]
RewriteRule ^asesoriacomercial(\.html)?/?$ /consultoria-inteligencia-comercial [R=301,L]
RewriteRule ^diagnostico-comercial(\.html)?/?$ https://diagnostico.lezacconsultoria.com/ [R=301,L]
RewriteRule ^asesoria-gratuita-global(\.html)?/?$ / [R=301,L]
RewriteRule ^seguimiento-post-venta(\.html)?/?$ /consultoria-inteligencia-comercial [R=301,L]
RewriteRule ^control-de-dso(\.html)?/?$ /consultoria-inteligencia-comercial [R=301,L]
RewriteRule ^comercio-electronico-y-su-impacto(\.html)?/?$ / [R=301,L]
RewriteRule ^como-optimizar-el-armado-de-tus-pedidos(\.html)?/?$ / [R=301,L]
RewriteRule ^tendencia-en-el-comercio-electronico(\.html)?/?$ / [R=301,L]
RewriteRule ^tendencias-de-dropshipping-para-2025(\.html)?/?$ / [R=301,L]
RewriteRule ^sostenibilidad-en-el-dropshipping(\.html)?/?$ / [R=301,L]
RewriteRule ^estrategias-omnicanal-para-mayoristas(\.html)?/?$ / [R=301,L]
RewriteRule ^servicios(\.html)?/?$ / [R=301,L]
RewriteRule ^bio-perfil-profesional(\.html)?/?$ /bio [R=301,L]
RewriteRule ^bioooo(\.html)?/?$ /bio [R=301,L]
RewriteRule ^ig-distribuidores-mayoristas(\.html)?/?$ / [R=301,L]
RewriteRule ^orden-en-el-deposito(\.html)?/?$ /consultoria-inteligencia-comercial [R=301,L]
RewriteRule ^blog-para-empresas(/.*)?$ /blog [R=301,L]
RewriteRule ^consultoria-360-comercial(\.html)?/?$ /consultoria-inteligencia-comercial [R=301,L]
RewriteRule ^nube-la-flexibilidad-en-empresas-mayoristas(/feed)?(\.html)?/?$ /blog [R=301,L]
RewriteRule ^landing-personal(\.html)?/?$ / [R=301,L]
RewriteRule ^inteligencia-artificial-empresas-mayorista(\.html)?/?$ /ia-a-medida [R=301,L]
RewriteRule ^evaluacion-eficiente(\.html)?/?$ /blog [R=301,L]
RewriteRule ^big-data(/feed)?(\.html)?/?$ /blog [R=301,L]
RewriteRule ^servicio-al-cliente(/feed)?(\.html)?/?$ / [R=301,L]

# Redirect .html URLs to clean URLs (301 permanent)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Internally serve .html files for clean URLs
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ /$1.html [L]

# Página 404 con enlaces a los servicios
ErrorDocument 404 /404.html
