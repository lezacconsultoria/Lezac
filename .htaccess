Options -MultiViews
RewriteEngine On

# Force /bio to the main-site page: a bio/ directory exists here as the
# docroot for the consultor.lezacconsultoria.com subdomain, so the generic
# rule below (which skips real directories) would never reach bio.html.
RewriteRule ^bio/?$ bio.html [L]

# Páginas del sitio anterior -> nueva estructura (301)
RewriteRule ^smart-brujula(\.html)?/?$      /brujula-comercial   [R=301,L]
RewriteRule ^censo-comercial(\.html)?/?$    /mas-clientes-activos [R=301,L]
RewriteRule ^geolocalizacion(\.html)?/?$    /mas-clientes-activos [R=301,L]
RewriteRule ^ruteo-comercial(\.html)?/?$    /mas-clientes-activos [R=301,L]
RewriteRule ^partners(\.html)?/?$           /partner             [R=301,L]

# Redirect .html URLs to clean URLs (301 permanent)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Internally serve .html files for clean URLs
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ /$1.html [L]
